menu "Example Configuration"

    config EXAMPLE_FIRMWARE_UPGRADE_URL
        string "Firmware Upgrade URL"
        default "https://192.168.1.100:8070/firmware.bin"
        help
            URL of server which hosts the firmware image.

    config EXAMPLE_OTA_CHECK_INTERVAL
        int "Delay between OTA checks (seconds)"
        range 10 3600
        default 30
        help
            Wait this long after connecting, then between failed or same-version checks.

    config EXAMPLE_OTA_RECV_TIMEOUT
        int "OTA Receive Timeout"
        range 1000 120000
        default 15000
        help
            Maximum time for reception

endmenu
